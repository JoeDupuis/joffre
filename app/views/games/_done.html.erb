<%= render 'score-board' %>

<% current_team = Current.player.team %>
<% other_team = current_team == 1 ? 2 : 1 %>
<% current_team_score = @game.team_total_score(current_team) %>
<% other_team_score = @game.team_total_score(other_team) %>
<% did_win = @game.winning_team == current_team %>
<% margin = current_team_score - other_team_score %>

<div class="round-result">
  <div class="title <%= did_win ? '-success' : '-failure' %>">
    <%= did_win ? 'You Win! 🏆' : 'You Lose 😞' %>
  </div>
  <div class="details">
    <div class="item">
      <span class="label">Your Team:</span>
      <span class="value"><%= current_team_score %></span>
    </div>
    <div class="item">
      <span class="label">Opponents:</span>
      <span class="value"><%= other_team_score %></span>
    </div>
    <div class="item">
      <span class="label"><%= did_win ? 'Victory' : 'Defeat' %> Margin:</span>
      <span class="value <%= did_win ? '-positive' : '-negative' %>"><%= signed_points(margin) %> points</span>
    </div>
  </div>
  <%= link_to "Back to Games", games_path, class: "link-button" %>
</div>

<%= render "score_history", summaries: @game.round_summaries, inline: true %>

<div class="player-hand"></div>
