<%
  play_order = @game.play_order
  current_player = Current.player

  if current_player && play_order.present?
    current_player_index = play_order.index(current_player)
    partner = play_order[(current_player_index + 2) % 4] if current_player_index
    opponent_left = play_order[(current_player_index + 1) % 4] if current_player_index
    opponent_right = play_order[(current_player_index + 3) % 4] if current_player_index
  end

  active_player = @game.active_player
  current_trick = @game.current_trick
  highest_bid = @game.highest_bid
  trump_suit = @game.trump_suit

  team_points = @game.team_round_points(current_player.team) if current_player

  played_cards = current_trick.cards.order(:trick_sequence).to_a
  last_trick = @game.last_completed_trick if played_cards.empty?
  played_cards = last_trick.cards.order(:trick_sequence).to_a if last_trick
  cards_by_player = played_cards.index_by(&:player_id)

  seats = [ [ partner, "top" ], [ opponent_left, "left" ], [ opponent_right, "right" ], [ current_player, "bottom" ] ]
%>

<div class="game-info">
  <div class="item">
    <span class="label">Trump:</span>
    <span class="value"><%= trump_suit&.capitalize || "None" %></span>
  </div>
  <div class="item">
    <span class="label">Bid:</span>
    <span class="value"><%= highest_bid&.amount || "N/A" %></span>
  </div>
  <div class="item">
    <span class="label">Bidder:</span>
    <span class="value">
      <% if highest_bid %>
        <%= highest_bid.player == current_player ? "You" : (highest_bid.player == partner ? partner.user.name : highest_bid.player.user.name) %>
      <% else %>
        N/A
      <% end %>
    </span>
  </div>
  <% if team_points %>
    <div class="item">
      <span class="label">Points:</span>
      <span class="value"><%= team_points %></span>
    </div>
  <% end %>
</div>

<div class="phase-area">
  <div class="message">
    <% if last_trick %>
      <span class="lasttrick"><%= player_label(last_trick.winner) %> took the trick ·</span>
    <% end %>
    <% if Current.player&.active? %>
      Playing - Your turn
    <% else %>
      <% if active_player %>
        Playing - Waiting for <%= active_player == partner ? partner.user.name : active_player.user.name %>
      <% else %>
        Playing
      <% end %>
    <% end %>
  </div>
</div>

<div class="game-container">
  <% if opponent_left %>
    <div class="player-name -left <%= '-active' if active_player == opponent_left %>">
      <span><%= dev_clickable_player_name(opponent_left, game: @game) %></span>
      <% if opponent_left.dealer? %>
        <span class="dealerpill">Dealer</span>
      <% end %>
    </div>
  <% end %>

  <% if partner %>
    <div class="player-name -top <%= '-active' if active_player == partner %>">
      <span><%= partner == current_player ? "You" : dev_clickable_player_name(partner, game: @game) %></span>
      <% if partner.dealer? %>
        <span class="dealerpill">Dealer</span>
      <% end %>
    </div>
  <% end %>

  <div class="table play-area <%= '-last' if last_trick %>">
    <% seats.each do |seat_player, seat| %>
      <% card = seat_player && cards_by_player[seat_player.id] %>
      <% next unless card %>
      <% won = last_trick&.winner_id == seat_player.id %>
      <div class="card -<%= seat %> <%= '-winner' if won %>">
        <%= image_tag "cards/#{card.suite}_#{card.rank}.png", alt: "#{card.suite.capitalize} #{card.rank}" %>
        <% if won %>
          <span class="points <%= last_trick.value.negative? ? '-negative' : '-positive' %>"><%= signed_points(last_trick.value) %></span>
        <% end %>
      </div>
    <% end %>
  </div>

  <% if current_player %>
    <div class="player-name -bottom <%= '-active' if active_player == current_player %>">
      <span>You</span>
      <% if current_player.dealer? %>
        <span class="dealerpill">Dealer</span>
      <% end %>
    </div>
  <% end %>

  <% if opponent_right %>
    <div class="player-name -right <%= '-active' if active_player == opponent_right %>">
      <span><%= dev_clickable_player_name(opponent_right, game: @game) %></span>
      <% if opponent_right.dealer? %>
        <span class="dealerpill">Dealer</span>
      <% end %>
    </div>
  <% end %>
</div>
