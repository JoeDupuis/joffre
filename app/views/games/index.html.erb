<div class="container">
  <h1>My Games</h1>

  <% if @games.any? %>
    <div class="games-list">
      <% @games.each do |game| %>
        <% owner = game.players.find(&:owner?)&.user == Current.user %>
        <div class="game-item">
          <h3 class="title"><%= link_to game.name, game %></h3>
          <p class="status">
            <span class="game-status -<%= game.status %>"><%= game_status_text(game) %></span>
          </p>
          <p class="info">
            <strong>Code:</strong> <%= game.game_code %>
            <span class="count">Starting bid <%= game.minimum_bid %> · Target <%= game.max_score %></span>
          </p>
          <% if owner || game.password_digest.present? %>
            <p class="info">
              <% if owner %>
                <span class="status-badge">Owner</span>
              <% end %>
              <% if game.password_digest.present? %>
                <span class="status-badge">Password Protected</span>
              <% end %>
            </p>
          <% end %>
          <% if owner && (game.pending? || game.done?) %>
            <%= button_to "Delete", game_path(game), method: :delete, class: "button -danger -small", data: { turbo_confirm: "Delete #{game.name}?" } %>
          <% elsif game.pending? && (player = game.players.find { |member| member.user_id == Current.user.id }) %>
            <%= button_to "Quit", games_player_path(player), method: :delete, class: "button -danger -small" %>
          <% end %>
        </div>
      <% end %>
    </div>
  <% else %>
    <p>You haven't joined any games yet.</p>
  <% end %>

  <div class="action-buttons">
    <%= link_to "Create New Game", new_game_path, class: "button" %>
    <%= link_to "Join Game", new_games_player_path, class: "button" %>
    <%= link_to "Back to Dashboard", root_path, class: "button -secondary" %>
  </div>
</div>
