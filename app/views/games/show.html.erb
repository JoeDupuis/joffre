<div class="game-page">
  <% if @game.pending? %>
    <%= render 'lobby' %>
  <% elsif @game.bidding? %>
    <%= render 'score-board' %>
    <%= render 'bidding' %>
    <%= render 'cards' %>
  <% elsif @game.playing? %>
    <%= render 'score-board' %>
    <%= render 'play' %>
    <%= render 'cards' %>
  <% elsif @game.done? %>
    <%= render 'done' %>
  <% end %>
</div>
