<div class="playing-card -<%= card.suite %> <%= "-figure" if card.rank.zero? %>" title="<%= card_label(card) %>">
  <% if card.rank.zero? %>
    <%= render "games/table/figure", card: %>
  <% else %>
    <span class="frame" aria-hidden="true"></span>
    <span class="corner -top" aria-hidden="true"><b><%= card.rank %></b><span class="suit-pip -<%= card.suite %>"></span></span>
    <span class="rank" aria-hidden="true"><%= card.rank %></span>
    <span class="corner -bottom" aria-hidden="true"><b><%= card.rank %></b><span class="suit-pip -<%= card.suite %>"></span></span>
  <% end %>
</div>
