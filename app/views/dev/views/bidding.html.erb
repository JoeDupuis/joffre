<%
  min_bid = (params[:bid] || 6).to_i.clamp(5, 12)
  name1 = params[:name1] || "Alice"
  name2 = params[:name2] || "Bob"
  name3 = params[:name3] || "Diana"
  show_pass = params[:pass] != "false"
  show_summary = params[:summary] != "false"
  set = params[:set] == "true"
%>
<div class="game-page">
  <div class="score-board">
    <div class="team-line">
      Team 1 (You & Partner): <span>0</span>
    </div>
    <div class="team-line">
      Team 2 (Opponents): <span>0</span>
    </div>
    <%= render "dev/views/score_history", open: params[:history] == "true" %>
  </div>

  <div class="bidding-panel">
    <% if show_summary %>
      <section class="round-summary">
        <header class="heading">
          <span class="title">Round 4</span>
          <span class="bid">
            <strong><%= name2 %></strong> bid <strong>8</strong>
          </span>
          <span class="outcome <%= set ? '-set' : '-made' %>"><%= set ? "Set" : "Made" %></span>
        </header>
        <div class="teams">
          <div class="team">
            <span class="name">Us</span>
            <span class="taken"><%= set ? 4 : 1 %> pts taken</span>
            <span class="score -positive">+<%= set ? 4 : 1 %></span>
          </div>
          <div class="team -bidding">
            <span class="name">Them</span>
            <span class="taken"><%= set ? 5 : 8 %> pts taken</span>
            <span class="score <%= set ? '-negative' : '-positive' %>"><%= set ? "−8" : "+8" %></span>
          </div>
        </div>
      </section>
    <% end %>

    <div class="game-info">
      <div class="item">
        <span class="label">Current Bid:</span>
        <span class="value">7</span>
      </div>
      <div class="item">
        <span class="label">High Bidder:</span>
        <span class="value"><%= name2 %></span>
      </div>
    </div>

    <div class="phase-area">
      <div class="message">
        Bidding - Your turn
      </div>
    </div>

    <div class="bid-history">
      <div class="title">Bidding Order</div>
      <div class="list">
        <div class="item">
          <span class="player"><%= name1 %></span>
          <span class="value -passed">Pass</span>
        </div>
        <div class="item">
          <span class="player"><%= name2 %></span>
          <span class="value">7</span>
        </div>
        <div class="item -current">
          <span class="player">You</span>
          <span class="value">?</span>
        </div>
        <div class="item">
          <span class="player"><%= name3 %></span>
          <span class="value">-</span>
        </div>
      </div>
    </div>

    <div class="bid-controls">
      <div class="options">
        <% (min_bid..12).each do |bid| %>
          <button class="bid-option"><%= bid %></button>
        <% end %>
        <% if show_pass %>
          <button class="bid-option -secondary">Pass</button>
        <% end %>
      </div>
    </div>
  </div>

  <div class="player-hand">
    <div class="card">
      <%= image_tag "cards/red_7.png", alt: "Red 7" %>
    </div>
    <div class="card">
      <%= image_tag "cards/red_5.png", alt: "Red 5" %>
    </div>
    <div class="card">
      <%= image_tag "cards/blue_7.png", alt: "Blue 7" %>
    </div>
    <div class="card">
      <%= image_tag "cards/blue_4.png", alt: "Blue 4" %>
    </div>
    <div class="card">
      <%= image_tag "cards/green_6.png", alt: "Green 6" %>
    </div>
    <div class="card">
      <%= image_tag "cards/green_3.png", alt: "Green 3" %>
    </div>
    <div class="card">
      <%= image_tag "cards/brown_7.png", alt: "Brown 7" %>
    </div>
    <div class="card">
      <%= image_tag "cards/brown_2.png", alt: "Brown 2" %>
    </div>
  </div>
</div>
