<%
  rounds = [
    { bidder: "You", bid: 7, made: true, us: 8, them: 0 },
    { bidder: "Bob", bid: 8, made: false, us: 4, them: -8 },
    { bidder: "Charlie", bid: 9, made: true, us: 11, them: -2 },
    { bidder: "Diana", bid: 7, made: true, us: 1, them: 7 }
  ]
  us_total = 0
  them_total = 0
%>
<details class="score-history <%= '-inline' if local_assigns[:inline] %>" <%= 'open' if local_assigns[:open] || local_assigns[:inline] %>>
  <summary class="toggle">Score history</summary>
  <table class="table">
    <thead>
      <tr>
        <th scope="col">#</th>
        <th scope="col">Bid</th>
        <th scope="col">Us</th>
        <th scope="col">Them</th>
      </tr>
    </thead>
    <tbody>
      <% rounds.each_with_index do |round, index| %>
        <% us_total += round[:us] %>
        <% them_total += round[:them] %>
        <tr>
          <td class="round"><%= index + 1 %></td>
          <td class="bid">
            <span class="bidder"><%= round[:bidder] %></span>
            <%= round[:bid] %><span class="outcome <%= round[:made] ? '-made' : '-set' %>"><%= round[:made] ? "✓" : "✗" %></span>
          </td>
          <% [ round[:us], round[:them] ].zip([ us_total, them_total ]).each do |delta, total| %>
            <td class="points">
              <span class="delta <%= '-negative' if delta.negative? %>"><%= delta.zero? ? "0" : (delta.negative? ? "−#{delta.abs}" : "+#{delta}") %></span>
              <span class="total"><%= total %></span>
            </td>
          <% end %>
        </tr>
      <% end %>
    </tbody>
  </table>
</details>
