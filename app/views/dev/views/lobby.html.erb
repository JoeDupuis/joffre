<div class="game-page">
  <h1>Friday Night Kaiser</h1>

  <div class="game-info">
    <p><strong>Game Code:</strong> ABC123</p>
    <p><em>This game is password protected</em></p>
  </div>

  <div class="team-display">
    <h2 class="title">Teams (4/4 players)</h2>
    <div class="container">
      <div class="team">
        <h3 class="heading">Team 1</h3>
        <ul class="players">
          <li class="player">
            Alice
            <span class="status-badge">Owner</span>
            <button class="link-button -small">→ Move to Team 2</button>
          </li>
          <li class="player">
            Charlie
            <button class="link-button -small">→ Move to Team 2</button>
            <button class="link-button -small">Kick</button>
          </li>
        </ul>
      </div>
      <div class="team">
        <h3 class="heading">Team 2</h3>
        <ul class="players">
          <li class="player">
            Bob
            <button class="link-button -small">← Move to Team 1</button>
            <button class="link-button -small">Kick</button>
          </li>
          <li class="player">
            Diana
            <button class="link-button -small">← Move to Team 1</button>
            <button class="link-button -small">Kick</button>
          </li>
        </ul>
      </div>
    </div>
  </div>

  <div class="actions">
    <button class="button">Start Game</button>
    <button class="button">Delete Game</button>
    <a href="#" class="button">Back to Dashboard</a>
  </div>
</div>
