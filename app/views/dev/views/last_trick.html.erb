<%
  dealer = (params[:dealer] || 2).to_i.clamp(1, 4)
  left_name = params[:left] || "Bob"
  top_name = params[:top] || "Charlie"
  bottom_name = params[:bottom] || "You"
  right_name = params[:right] || "Diana"
  trump = params[:trump] || "Opponents"
  winner = %w[left top right bottom].include?(params[:winner]) ? params[:winner] : "top"
  value = (params[:value] || 6).to_i
  winner_name = { "left" => left_name, "top" => top_name, "right" => right_name, "bottom" => "You" }[winner]
  trick = { "top" => "red_0", "left" => "red_3", "right" => "red_7", "bottom" => "red_5" }
%>
<div class="game-page">
  <div class="header">
    <div class="score-board">
      <div class="team-line">
        Team 1 (You & Partner): <span>12</span>
      </div>
      <div class="team-line">
        Team 2 (Opponents): <span>8</span>
      </div>
      <%= render "dev/views/score_history", open: params[:history] == "true" %>
    </div>

    <div class="game-info">
      <div class="item">
        <span class="label">Trump:</span>
        <span class="value"><%= trump %></span>
      </div>
      <div class="item">
        <span class="label">Bid:</span>
        <span class="value">8</span>
      </div>
      <div class="item">
        <span class="label">Bidder:</span>
        <span class="value">Bidder</span>
      </div>
      <div class="item">
        <span class="label">Points:</span>
        <span class="value">6</span>
      </div>
    </div>

    <div class="phase-area">
      <div class="message">
        <span class="lasttrick"><%= winner_name %> took the trick ·</span>
        Playing - Your turn
      </div>
    </div>
  </div>

  <div class="table game-container">
    <div class="player-name -left">
      <span class="name"><%= left_name %></span>
      <% if dealer == 1 %><span class="dealerpill">Dealer</span><% end %>
    </div>

    <div class="player-name -top">
      <span class="name"><%= top_name %></span>
      <% if dealer == 2 %><span class="dealerpill">Dealer</span><% end %>
    </div>

    <div class="table play-area -last">
      <% %w[top left right bottom].each do |seat| %>
        <div class="card -<%= seat %> <%= '-winner' if seat == winner %>">
          <%= image_tag "cards/#{trick[seat]}.png", alt: trick[seat].titleize %>
          <% if seat == winner %>
            <span class="points <%= value.negative? ? '-negative' : '-positive' %>"><%= value.negative? ? "−#{value.abs}" : "+#{value}" %></span>
          <% end %>
        </div>
      <% end %>
    </div>

    <div class="player-name -bottom -active">
      <span class="name"><%= bottom_name %></span>
      <% if dealer == 3 %><span class="dealerpill">Dealer</span><% end %>
    </div>

    <div class="player-name -right">
      <span class="name"><%= right_name %></span>
      <% if dealer == 4 %><span class="dealerpill">Dealer</span><% end %>
    </div>
  </div>

  <%
    cards = (params[:cards] || 8).to_i.clamp(0, 8)
    all_cards = [
      { image: "red_5", playable: false },
      { image: "red_7", playable: true },
      { image: "blue_4", playable: true },
      { image: "green_6", playable: false },
      { image: "green_3", playable: false },
      { image: "brown_7", playable: false },
      { image: "brown_4", playable: false },
      { image: "brown_2", playable: false }
    ]
  %>
  <div class="hand player-hand">
    <% all_cards.first(cards).each do |card| %>
      <% if card[:playable] %>
        <button class="card">
          <%= image_tag "cards/#{card[:image]}.png", alt: card[:image].titleize %>
        </button>
      <% else %>
        <div class="card -unplayable">
          <%= image_tag "cards/#{card[:image]}.png", alt: card[:image].titleize %>
        </div>
      <% end %>
    <% end %>
  </div>
</div>
